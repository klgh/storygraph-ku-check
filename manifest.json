{
  "$schema": "https://json.schemastore.org/chrome-manifest",
  "name": "StoryGraph Kindle Unlimited Checker",
  "description": "Check whether a StoryGraph book is included with Kindle Unlimited.",
  "homepage_url": "https://github.com/klgh/storygraph-ku-check",
  "version": "0.0.0.1",
  "manifest_version": 3,
  "minimum_chrome_version": "130",
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://app.thestorygraph.com/*",
    "https://www.amazon.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://app.thestorygraph.com/*"
      ],
      "js": [
        "storygraph.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.amazon.com/*"
      ],
      "js": [
        "amazon.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
