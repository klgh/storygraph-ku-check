{
  "name": "StoryGraph Kindle Unlimited Checker",
  "description": "Checks whether a StoryGraph book appears to be available through Kindle Unlimited.",
  "version": "0.0.0.1",
  "manifest_version": 3,
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://app.thestorygraph.com/*",
    "https://www.amazon.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://app.thestorygraph.com/*"
      ],
      "js": [
        "storygraph.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.amazon.com/*"
      ],
      "js": [
        "amazon.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
